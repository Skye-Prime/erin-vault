def _build_page(name):
    import html as _html
    js = _PAGE_JS.replace("__CRED_NAME_JS__", json.dumps(name))
    page = _PAGE_HTML.replace("__PAGE_JS__", _VCRYPT_JS + "\n" + js)
    return page.replace("__CRED_NAME_HTML__", _html.escape(name))


def _new_code():
    """One-time encryption code: 12 unambiguous chars (~60 bits), grouped."""
    import secrets
    raw = "".join(secrets.choice(CODE_ALPHABET) for _ in range(CODE_LEN))
    return "-".join(raw[i:i + 4] for i in range(0, CODE_LEN, 4))


def _norm_code(s):
    return "".join(c for c in s.lower() if c in CODE_ALPHABET)


def _derive_code_key(code_norm, salt):
    from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
    from cryptography.hazmat.primitives import hashes
    return PBKDF2HMAC(
        algorithm=hashes.SHA256(), length=32, salt=salt,
        iterations=PBKDF2_ITERS,
    ).derive(code_norm.encode())


def _decrypt_submit(suite, code_norm, name, salt, iv, ct):
    """Decrypt a serve-store submission. Raises on wrong code / tampering."""
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM, ChaCha20Poly1305
    key = _derive_code_key(code_norm, salt)
    aad = AAD_PREFIX + name.encode()
    if suite == "aesgcm-v1":
        return AESGCM(key).decrypt(iv, ct, aad)
    if suite == "chacha-v1":
        return ChaCha20Poly1305(key).decrypt(iv, ct, aad)
    raise ValueError("unknown suite")


def _run_security(args):
    import subprocess
    try:
        result = subprocess.run(
            ["security"] + args, capture_output=True, text=True, timeout=10
        )
        return result
    except (FileNotFoundError, OSError):
        # No `security` CLI (Linux, minimal macOS env): Keychain unavailable.
        class _Failed:
            returncode = 1
            stdout = ""
            stderr = ""
        return _Failed()


def get_or_create_master_key():
    # Check the fallback file FIRST. Over SSH the macOS Keychain is usually
    # locked ("User interaction is not allowed"); if we asked the Keychain
    # first while it was unlocked-but-empty we'd mint a second, different key
    # and permanently break decryption of the existing vault.
    if os.path.exists(KEY_FILE):
        with open(KEY_FILE, "r") as f:
            return f.read().strip()

    # Try macOS Keychain
    r = _run_security([
        "find-generic-password", "-s", KEYCHAIN_SERVICE,
        "-a", KEYCHAIN_ACCOUNT, "-w"
    ])
    if r.returncode == 0 and r.stdout.strip():
        return r.stdout.strip()

    # Mint a new key and try to store it in the Keychain
    from cryptography.fernet import Fernet
    key = Fernet.generate_key().decode()
    r = _run_security([
        "add-generic-password", "-s", KEYCHAIN_SERVICE,
        "-a", KEYCHAIN_ACCOUNT, "-w", key, "-U"
    ])
    if r.returncode == 0:
        print("Master key created in macOS Keychain.")
        return key

    # Keychain unavailable (headless/SSH/Linux) — 0600 key file instead.
    os.makedirs(VAULT_DIR, mode=0o700, exist_ok=True)
    with open(KEY_FILE, "w") as f:
        f.write(key)
    os.chmod(KEY_FILE, 0o600)
    print("Master key stored in secure local file.")
    return key


def get_fernet():
    from cryptography.fernet import Fernet
    return Fernet(get_or_create_master_key().encode())


def load_vault():
    if not os.path.exists(VAULT_FILE):
        return {}
    with open(VAULT_FILE, "rb") as f:
        encrypted = f.read()
    try:
        return json.loads(get_fernet().decrypt(encrypted))
    except Exception as e:
        print(f"Vault decrypt failed: {e}", file=sys.stderr)
        sys.exit(1)


def save_vault(data):
    os.makedirs(VAULT_DIR, mode=0o700, exist_ok=True)
    encrypted = get_fernet().encrypt(json.dumps(data).encode())
    with open(VAULT_FILE, "wb") as f:
        f.write(encrypted)
    os.chmod(VAULT_FILE, 0o600)


def _secure_delete_var(name, namespace):
    """Best-effort memory clearing (defense-in-depth; CPython strings are
    immutable, so this only overwrites the reference)."""
    if name in namespace:
        val = namespace[name]
        if isinstance(val, str):
            namespace[name] = "x" * len(val)
        del namespace[name]


def _store_entry(name, username, value):
    vault = load_vault()
    vault[name] = {
        "username": username,
        "value": base64.b64encode(value.encode()).decode(),
        "created": time.strftime("%Y-%m-%dT%H:%M:%S"),
    }
    save_vault(vault)


def cmd_store(name, username=None):
    print(f"Storing credential '{name}'.")
    if username:
        print(f"Username: {username}")
    else:
        username = input("Username/email (or Enter to skip): ").strip() or None
    value = getpass.getpass("Password/value (hidden): ")
    if not value:
        print("Empty, aborting.", file=sys.stderr)
        sys.exit(1)
    if getpass.getpass("Confirm: ") != value:
        print("Mismatch, aborting.", file=sys.stderr)
        sys.exit(1)

    _store_entry(name, username, value)
    _secure_delete_var("value", locals())
    print(f"'{name}' stored securely.")


def cmd_list():
    vault = load_vault()
    if not vault:
        print("No credentials stored.")
        return
    for name, meta in vault.items():
        u = f" (user: {meta.get('username', 'n/a')})" if meta.get("username") else ""
        print(f"  {name}{u} — stored {meta.get('created', '?')}")


def cmd_delete(name):
    vault = load_vault()
    if name not in vault:
        print(f"'{name}' not found.", file=sys.stderr)
        sys.exit(1)
    del vault[name]
    save_vault(vault)
    print(f"'{name}' deleted.")


def cmd_serve_store(name, port=18443, bind="127.0.0.1"):
    """One-time local web form with END-TO-END encryption.

    The browser encrypts the password (PBKDF2-SHA256 600k -> AES-256-GCM, or
    a verified ChaCha20-Poly1305 fallback) with a one-time encryption code
    before anything travels. A passive network listener sees only
    ciphertext; the code itself travels via the agent's chat, a separate
    channel. Binds localhost by default. Shuts down after one successful
    submission, 25 failed attempts, or 10 minutes.
    """
    from http.server import BaseHTTPRequestHandler, HTTPServer

    enc_code = _new_code()
    code_norm = _norm_code(enc_code)
    failed = [0]
    result = {}
    page = _build_page(name)

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass  # no logging: URLs/bodies are sensitive

        def _reply(self, status, body, ctype="text/html"):
            data = body.encode() if isinstance(body, str) else body
            self.send_response(status)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            if self.path not in ("/", "/index.html"):
                self._reply(404, "Not found", "text/plain")
                return
            self._reply(200, page)

        def do_POST(self):
            if self.path != "/submit":
                self._reply(404, "Not found", "text/plain")
                return
            try:
                length = int(self.headers.get("Content-Length", 0))
            except ValueError:
                length = 0
            if length <= 0 or length > 65536:
                self._reply(400, "Bad request", "text/plain")
                return
            try:
                data = json.loads(self.rfile.read(length).decode())
                suite = data["suite"]
                salt = base64.b64decode(data["salt"])
                iv = base64.b64decode(data["iv"])
                ct = base64.b64decode(data["ct"])
                if suite not in SUITES:
                    raise ValueError("suite")
                if len(salt) != 16 or len(iv) != 12 or not (0 < len(ct) <= 8192):
                    raise ValueError("sizes")
            except Exception:
                self._reply(400, "Bad request", "text/plain")
                return
            try:
                raw = _decrypt_submit(suite, code_norm, name, salt, iv, ct)
                payload = json.loads(raw.decode("utf-8"))
                password = payload["p"]
                username = payload.get("u") or None
                if not isinstance(password, str) or not password:
                    raise ValueError("payload")
                if username is not None and not isinstance(username, str):
                    raise ValueError("payload")
            except Exception:
                failed[0] += 1
                if failed[0] >= SERVE_MAX_FAILS:
                    result["abort"] = True
                    self._reply(403, "Too many failed attempts.", "text/plain")
                else:
                    self._reply(400, "Invalid encryption code.", "text/plain")
                return
            result["username"] = username
            result["password"] = password
            self._reply(200, "Stored.")

    server = HTTPServer((bind, port), Handler)
    server.timeout = 1.0

    url = f"http://{bind}:{port}/"
    print(f"VAULT_URL:{url}", flush=True)
    print(f"VAULT_CODE:{enc_code}", flush=True)
    print("End-to-end encrypted: the password is encrypted in the browser with this code")
    print("before it travels. Relay the URL and the code to the human.")
    print(f"Server shuts down after one successful submission, {SERVE_MAX_FAILS} failed")
    print(f"attempts, or {SERVE_TIMEOUT_SECS // 60} minutes.")

    start = time.time()
    while time.time() - start < SERVE_TIMEOUT_SECS:
        server.handle_request()
        if "password" in result or "abort" in result:
            break

    server.server_close()

    if "password" not in result:
        print("No credential stored.", file=sys.stderr)
        sys.exit(1)

    _store_entry(name, result["username"], result["password"])
    result["password"] = "x" * len(result["password"])
    del result["password"]
    print(f"'{name}' stored securely via encrypted web form.")


def _filter_secrets(data: bytes, secrets_list) -> bytes:
    """Remove credential values from output before it reaches the caller."""
    for s in secrets_list:
        if s and len(s) >= 4:
            data = data.replace(s.encode(), b"[REDACTED]")
    return data


def _strip_ansi(text: str) -> str:
    return re.sub(r"\x1b\[[0-9;?]*[a-zA-Z]", "", text)


def cmd_run(name, command_args, override_username=None, twofa_pipe=None):
    vault = load_vault()
    if name not in vault:
        print(f"'{name}' not found.", file=sys.stderr)
        sys.exit(1)

    entry = vault[name]
    password = base64.b64decode(entry["value"]).decode()
    username = override_username or entry.get("username")
    del vault, entry

    secrets_to_filter = [password]
    if username:
        secrets_to_filter.append(username)

    pid, fd = pty.fork()
    if pid == 0:
        os.execvp(command_args[0], command_args)

    fired_handlers = set()
    username_sent = False
    password_sent = False
    twofa_sent = False
    output_buffer = b""

    for f in [TWOFA_MARKER, twofa_pipe or ""]:
        try:
            if f:
                os.unlink(f)
        except OSError:
            pass

    try:
        while True:
            r, _, _ = select.select([fd], [], [], 1.0)
            if fd in r:
                try:
                    data = os.read(fd, 4096)
                except OSError:
                    break
                if not data:
                    break
                # FILTER secrets before echoing to caller
                filtered = _filter_secrets(data, secrets_to_filter)
                sys.stdout.buffer.write(filtered)
                sys.stdout.buffer.flush()

                output_buffer += data
                if len(output_buffer) > 16384:
                    output_buffer = output_buffer[-16384:]
                text = _strip_ansi(output_buffer.decode(errors="replace"))

                handled = False

                # App-specific handlers (each fires once)
                for i, (pattern, reply, note) in enumerate(EXTRA_PROMPT_HANDLERS):
                    if i not in fired_handlers and re.search(pattern, text, re.IGNORECASE):
                        time.sleep(0.3)
                        os.write(fd, (reply + "\r").encode())
                        fired_handlers.add(i)
                        output_buffer = b""
                        print(f"\n[erin-vault: answered prompt ({note})]", flush=True)
                        handled = True
                        break

                if handled:
                    continue

                # Username / identity prompt (before password)
                if username and not username_sent and re.search(
                    r"(apple\s*id|username|email|login)", text, re.IGNORECASE
                ):
                    time.sleep(0.3)
                    os.write(fd, (username + "\r").encode())
                    username_sent = True
                    output_buffer = b""
                    print("\n[erin-vault: username injected]", flush=True)

                # Password prompt
                elif not password_sent and re.search(r"password", text, re.IGNORECASE):
                    time.sleep(0.5)
                    os.write(fd, (password + "\r").encode())
                    password_sent = True
                    output_buffer = b""
                    print("\n[erin-vault: credential injected]", flush=True)

                # 2FA prompt
                elif password_sent and not twofa_sent and twofa_pipe and re.search(
                    r"(verification\s*code|2fa|two.?factor|6.?digit|authenticator|one.?time)",
                    text, re.IGNORECASE
                ):
                    with open(TWOFA_MARKER, "w") as f:
                        f.write("needed")
                    os.chmod(TWOFA_MARKER, 0o600)
                    print("\n[erin-vault: 2FA code needed — waiting...]", flush=True)
                    waited = 0
                    while waited < 300:
                        if os.path.exists(twofa_pipe):
                            with open(twofa_pipe) as f:
                                code = f.read().strip()
                            if code:
                                os.unlink(twofa_pipe)
                                try:
                                    os.unlink(TWOFA_MARKER)
                                except OSError:
                                    pass
                                os.write(fd, (code + "\r").encode())
                                twofa_sent = True
                                output_buffer = b""
                                print("[erin-vault: 2FA injected]", flush=True)
                                code = "x" * len(code)
                                break
                        time.sleep(2)
                        waited += 2
    finally:
        _secure_delete_var("password", locals())
        try:
            os.unlink(TWOFA_MARKER)
        except OSError:
            pass

    _, status = os.waitpid(pid, 0)
    exit_code = os.waitstatus_to_exitcode(status)
    print(f"\n[erin-vault: exited {exit_code}]", flush=True)
    sys.exit(exit_code)


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)
    cmd = sys.argv[1]

    if cmd == "--version":
        print(f"erin-vault {VERSION}")
    elif cmd == "store" and len(sys.argv) >= 3:
        # erin-vault store <name> [--username U]
        name = sys.argv[2]
        username = None
        if "--username" in sys.argv:
            username = sys.argv[sys.argv.index("--username") + 1]
        cmd_store(name, username)
    elif cmd == "serve-store" and len(sys.argv) >= 3:
        # erin-vault serve-store <name> [--port P] [--bind ADDR]
        name = sys.argv[2]
        port = 18443
        bind = "127.0.0.1"
        if "--port" in sys.argv:
            port = int(sys.argv[sys.argv.index("--port") + 1])
        if "--bind" in sys.argv:
            bind = sys.argv[sys.argv.index("--bind") + 1]
        cmd_serve_store(name, port, bind)
    elif cmd == "list":
        cmd_list()
    elif cmd == "delete" and len(sys.argv) == 3:
        cmd_delete(sys.argv[2])
    elif cmd == "run":
        args = sys.argv[2:]
        if not args:
            print("Usage: erin-vault run <name> [--username U] [--2fa-pipe P] -- <cmd>",
                  file=sys.stderr)
            sys.exit(1)
        name = args[0]
        args = args[1:]
        username = None
        twofa_pipe = None
        if "--username" in args:
            idx = args.index("--username")
            username = args[idx + 1]
            args = args[:idx] + args[idx + 2:]
        if "--2fa-pipe" in args:
            idx = args.index("--2fa-pipe")
            twofa_pipe = args[idx + 1]
            args = args[:idx] + args[idx + 2:]
            d = os.path.dirname(twofa_pipe) or "."
            os.makedirs(d, mode=0o700, exist_ok=True)
        if args and args[0] == "--":
            args = args[1:]
        if not args:
            print("No command.", file=sys.stderr)
            sys.exit(1)
        cmd_run(name, args, username, twofa_pipe)
    else:
        print(f"Unknown: {cmd}", file=sys.stderr)
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    main()
