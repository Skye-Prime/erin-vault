async function va_wcEncrypt(codeNorm, salt, iv, aad, plaintext){
  var te = new TextEncoder();
  var baseKey = await crypto.subtle.importKey("raw", te.encode(codeNorm), "PBKDF2", false, ["deriveKey"]);
  var key = await crypto.subtle.deriveKey(
    {name: "PBKDF2", salt: salt, iterations: VAULT_PBKDF2_ITERS, hash: "SHA-256"},
